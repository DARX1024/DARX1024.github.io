---
// 博客与笔记共用的文章布局：标题区 + 正文 + 宽屏右侧目录
import 'katex/dist/katex.min.css';
import '../styles/prose.css';
import Base from './Base.astro';
import type { MarkdownHeading } from 'astro';
import { fmtDateLong } from '../lib/content';
import katex from 'katex';

// 目录文字里的 $…$ 渲染成公式（见 plugins/rehype-heading-math.mjs）
const escapeHtml = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const tocHtml = (text: string) =>
  text
    .split(/(\$[^$]+\$)/)
    .map((part) =>
      /^\$[^$]+\$$/.test(part)
        ? katex.renderToString(part.slice(1, -1), { throwOnError: false, output: 'html' })
        : escapeHtml(part),
    )
    .join('');

interface Props {
  title: string;
  description?: string;
  date?: Date;
  updated?: Date;
  tags?: string[];
  minutes?: number;
  headings?: MarkdownHeading[];
  showToc?: boolean;
  /** 标题的 view-transition-name，与列表页里同一篇的标题对应 */
  vt?: string;
}
const { title, description, date, updated, tags = [], minutes, headings = [], showToc = true, vt } = Astro.props;
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3 && h.slug !== 'footnote-label');
const hasToc = showToc && toc.length >= 3;
---

<Base title={title} description={description}>
  <article class="article">
    <header class="article-header">
      <slot name="kicker" />
      <h1 style={vt ? `view-transition-name:${vt}` : undefined}>
        {title}
      </h1>
      {description && <p class="article-desc">{description}</p>}
      <div class="article-meta">
        {date && <time datetime={date.toISOString()}>{fmtDateLong(date)}</time>}
        {updated && <span>更新于 {fmtDateLong(updated)}</span>}
        {minutes && <span>约 {minutes} 分钟</span>}
      </div>
      {tags.length > 0 && <div class="tags article-tags">{tags.map((t) => <span>{t}</span>)}</div>}
      <slot name="meta" />
    </header>

    {
      hasToc && (
        <nav class="toc" aria-label="目录">
          <div class="toc-inner">
          <div class="toc-label">目录</div>
          <ol>
            {toc.map((h) => (
              <li class={`d${h.depth}`}>
                <a href={`#${h.slug}`} set:html={tocHtml(h.text)} />
              </li>
            ))}
          </ol>
          </div>
        </nav>
      )
    }

    <div class="prose">
      <slot />
    </div>

    <slot name="after" />
  </article>
</Base>

<style>
  .article-header {
    margin: 1rem 0 3.25rem;
    padding-bottom: 2.25rem;
    border-bottom: 1px solid var(--border);
  }
  h1 {
    font-size: clamp(1.9rem, 4.2vw, 2.5rem);
    line-height: 1.25;
    font-weight: 600;
    letter-spacing: -0.015em;
    margin: 0 0 1rem;
    text-wrap: balance;
  }
  .article-desc {
    color: var(--fg-soft);
    margin: 0 0 1.4rem;
    font-size: 1.125rem;
    line-height: 1.8;
  }
  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0;
    color: var(--muted);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }
  .article-tags {
    margin-top: 0.6rem;
    font-size: 0.875rem;
  }
  .article-meta > * + *::before {
    content: '·';
    margin: 0 0.7rem;
    opacity: 0.6;
  }

  /* 目录：宽屏固定在正文左侧（右侧留给旁注），窄屏收在标题下方 */
  .toc {
    font-size: 0.8125rem;
    line-height: 1.55;
    margin: -1.5rem 0 2.5rem;
    padding: 0.8rem 1rem;
    border: 1px solid var(--border);
    border-radius: 6px;
  }
  .toc-label {
    color: var(--muted);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    margin-bottom: 0.4rem;
  }
  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .toc li {
    padding-block: 0.15rem;
  }
  .toc li.d3 {
    padding-left: 1em;
  }
  .toc a {
    text-decoration: none;
    color: var(--muted);
  }
  .toc a:hover,
  .toc a.active {
    color: var(--fg);
  }
  @media (min-width: 76rem) {
    .article {
      position: relative;
    }
    .toc {
      position: absolute;
      right: calc(100% + 5rem);
      top: 0;
      bottom: 0;
      width: 11.5rem;
      margin: 0;
      padding: 0;
      border: 0;
    }
    .toc-inner {
      position: sticky;
      top: 6rem;
      max-height: calc(100vh - 8rem);
      overflow-y: auto;
    }
  }
</style>

<script>
  // ---- 旁注：宽屏把每条脚注放到引用处右侧的页边，像书页边上的批注 ----
  const prose = document.querySelector<HTMLElement>('.article .prose');
  const refs = prose ? [...prose.querySelectorAll<HTMLAnchorElement>('sup a[data-footnote-ref]')] : [];
  if (prose && refs.length) {
    const notes = refs.flatMap((a) => {
      const li = document.getElementById(decodeURIComponent(a.hash.slice(1)));
      if (!li) return [];
      const aside = document.createElement('aside');
      aside.className = 'sidenote';
      for (const c of li.children) aside.append(c.cloneNode(true));
      const num = document.createElement('span');
      num.className = 'sn-num';
      num.textContent = a.textContent ?? '';
      aside.firstElementChild?.prepend(num);
      prose.append(aside);
      return [[a, aside] as const];
    });
    prose.classList.add('has-sidenotes');
    const wide = matchMedia('(min-width: 76rem)');
    const place = () => {
      if (!wide.matches) return;
      const top0 = prose.getBoundingClientRect().top;
      // 宽屏下可视化会伸进右侧页边，旁注要避开
      const blocks = [...prose.querySelectorAll('figure.viz')].map((f) => {
        const r = f.getBoundingClientRect();
        return [r.top - top0, r.bottom - top0];
      });
      let floor = 0;
      for (const [a, aside] of notes) {
        let y = Math.max(a.getBoundingClientRect().top - top0 - 2, floor);
        const h = aside.offsetHeight;
        for (const [b0, b1] of blocks) if (y < b1 && y + h > b0) y = b1 + 12;
        aside.style.top = `${y}px`;
        floor = y + h + 14;
      }
    };
    place();
    wide.addEventListener('change', place);
    new ResizeObserver(place).observe(prose);
  }

  // 目录高亮当前阅读位置：最后一个已经滚过页面顶部的小标题
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
  const heads = links
    .map((a) => [a, document.getElementById(decodeURIComponent(a.hash.slice(1)))] as const)
    .filter(([, h]) => h);
  if (heads.length) {
    let ticking = false;
    const update = () => {
      ticking = false;
      let cur: HTMLAnchorElement | undefined;
      for (const [a, h] of heads) if (h!.getBoundingClientRect().top < 140) cur = a;
      // 滚到底时最后几节可能到不了顶部，直接算最后一节
      if (innerHeight + scrollY >= document.documentElement.scrollHeight - 4) cur = heads[heads.length - 1][0];
      links.forEach((a) => a.classList.toggle('active', a === cur));
    };
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    update();
  }
</script>
