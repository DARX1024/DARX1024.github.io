---
// 标题西文字体：只加载拉丁字符的 600 字重（约 24KB），中文仍用系统字体
import '@fontsource/newsreader/latin-600.css';
import '../styles/global.css';
import { SITE, NAV } from '../site.config';
import { getPosts } from '../lib/content';
import { hasLife } from '../lib/games';

interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
}
const { title, description = SITE.description, wide = false } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
// 还没有文章的栏目先不放进导航
const hasPosts = (await getPosts()).length > 0;
const lifeReady = await hasLife();
const nav = NAV.filter((n) => (n.href !== '/blog/' || hasPosts) && (n.href !== '/life/' || lifeReady));
const isCurrent = (n: (typeof NAV)[number]) => [n.href, ...(n.match ?? [])].some((p) => path.startsWith(p));
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#171513" />
    <script is:inline>
      // 在首帧之前确定主题，避免闪烁。默认深色；用户手动切换过则记住选择。
      (() => {
        let t = null;
        try { t = localStorage.getItem('theme'); } catch {}
        if (t !== 'light' && t !== 'dark') t = 'dark';
        document.documentElement.dataset.theme = t;
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <div class="read-progress" aria-hidden="true"></div>
    <header class="site-header">
      <div class="container wide">
        <a class="site-title" href="/"><span class="site-mark" aria-hidden="true"></span>{SITE.title}</a>
        <nav class="site-nav" aria-label="主导航">
          {
            nav.map((n) => (
              <a href={n.href} aria-current={isCurrent(n) ? 'page' : undefined}>
                {n.label}
              </a>
            ))
          }
          <button class="theme-toggle" type="button" aria-label="切换亮色/暗色">
            <svg class="sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
            <svg class="moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path></svg>
          </button>
        </nav>
      </div>
    </header>

    <main>
      <div class:list={['container', { wide }]}>
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="container wide">
        <span class="spacer">© {new Date().getFullYear()} {SITE.author}</span>
        <a href="/rss.xml">RSS</a>
        {SITE.github && <a href={SITE.github}>GitHub</a>}
        {SITE.email && <a href={`mailto:${SITE.email}`}>Email</a>}
      </div>
    </footer>

    <script>
      const root = document.documentElement;

      // ---- 页头：滚动后显示分隔线；文章页顶部阅读进度 ----
      const header = document.querySelector('.site-header');
      const bar = document.querySelector<HTMLElement>('.read-progress');
      const article = document.querySelector('.article');
      const onScroll = () => {
        header?.classList.toggle('scrolled', scrollY > 8);
        if (bar && article) {
          const r = article.getBoundingClientRect();
          const p = Math.min(1, Math.max(0, -r.top / Math.max(1, r.height - innerHeight)));
          bar.style.transform = `scaleX(${p})`;
        }
      };
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // ---- 主题切换：新主题从按钮处圆形扩散开（不支持 View Transitions 或减少动态效果时直接切换） ----
      const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
      toggle?.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        const apply = () => {
          root.dataset.theme = next;
          try { localStorage.setItem('theme', next); } catch {}
          document.querySelectorAll<HTMLIFrameElement>('iframe.viz-frame').forEach(syncTheme);
        };
        if (!document.startViewTransition || matchMedia('(prefers-reduced-motion: reduce)').matches) {
          apply();
          return;
        }
        const r = toggle.getBoundingClientRect();
        const x = r.left + r.width / 2;
        const y = r.top + r.height / 2;
        const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
        root.classList.add('theme-vt');
        const t = document.startViewTransition(apply);
        t.ready
          .then(() => {
            root.animate(
              { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
              { duration: 560, easing: 'cubic-bezier(0.3, 0.6, 0.2, 1)', pseudoElement: '::view-transition-new(root)' },
            );
          })
          .catch(() => {});
        t.finished.finally(() => root.classList.remove('theme-vt'));
      });

      // ---- 可视化 iframe：同步主题 + 自动高度 ----
      // 可视化页面可以用 :root[data-theme="dark"] 写暗色样式；不写也没关系。
      // 把网站当前配色以 --site-* 变量传进去；可视化可以用 :root[data-embedded] 接上（见 README）
      const SITE_TOKENS = ['bg', 'bg-soft', 'fg', 'fg-soft', 'muted', 'border', 'accent', 'font-body', 'font-heading', 'font-mono'];
      function syncTheme(f: HTMLIFrameElement) {
        try {
          const el = f.contentDocument?.documentElement;
          if (!el) return;
          const cs = getComputedStyle(root);
          for (const t of SITE_TOKENS) el.style.setProperty(`--site-${t}`, cs.getPropertyValue(`--${t}`).trim());
          el.dataset.embedded = '';
          el.dataset.theme = root.dataset.theme;
        } catch {}
      }
      function fit(f: HTMLIFrameElement) {
        try {
          const d = f.contentDocument;
          const body = d?.body;
          if (!d || !body) return;
          // 用内容的实际底边计算高度（scrollHeight 不会小于 iframe 当前高度，无法收缩）
          const win = d.defaultView!;
          let bottom = 0;
          for (const el of body.children) {
            if (el.tagName === 'SCRIPT' || el.tagName === 'STYLE') continue;
            const r = el.getBoundingClientRect();
            bottom = Math.max(bottom, r.bottom + win.scrollY + parseFloat(win.getComputedStyle(el).marginBottom || '0'));
          }
          const cs = win.getComputedStyle(body);
          const h = Math.ceil(bottom + parseFloat(cs.paddingBottom) + parseFloat(cs.marginBottom));
          if (h > 0) f.style.height = h + 'px';
        } catch {}
      }
      function setup(f: HTMLIFrameElement) {
        syncTheme(f);
        if (!('autoheight' in f.dataset)) return;
        fit(f);
        try {
          const d = f.contentDocument;
          if (d?.body) new ResizeObserver(() => fit(f)).observe(d.body);
        } catch {}
      }
      document.querySelectorAll<HTMLIFrameElement>('iframe.viz-frame').forEach((f) => {
        f.addEventListener('load', () => setup(f));
        if (f.contentDocument?.readyState === 'complete' && f.contentDocument.URL !== 'about:blank') setup(f);
      });
    </script>
  </body>
</html>
