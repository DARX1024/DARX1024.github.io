---
import Base from '../layouts/Base.astro';
import VizCard from '../components/VizCard.astro';
import Globe from '../components/Globe.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../site.config';
import { getPosts, getNotes, getSeries, seriesIdOf, titleOf, fmtDate } from '../lib/content';

// 动态：博客、笔记、可视化合在一起按时间倒序，做成时间线
const [posts, notes, series, allViz] = await Promise.all([getPosts(), getNotes(), getSeries(), getCollection('viz')]);
const seriesTitle = (id?: string) => series.find((s) => s.id === id)?.title;
const RANK = { 博客: 0, 笔记: 1, 可视化: 2 } as const;
type Item = { kind: keyof typeof RANK; href: string; title: string; desc?: string; date?: Date; where?: string };
const news: Item[] = [
  ...posts.map((p) => ({ kind: '博客' as const, href: `/blog/${p.id}/`, title: titleOf(p), desc: p.data.description, date: p.data.date })),
  ...notes.map((n) => ({ kind: '笔记' as const, href: `/notes/${n.id}/`, title: titleOf(n), desc: n.data.description, date: n.data.date, where: seriesTitle(seriesIdOf(n)) })),
  ...allViz.map((v) => ({ kind: '可视化' as const, href: `/viz/${v.id}/`, title: v.data.title, desc: v.data.description, date: v.data.date })),
]
  .sort((a, b) => (b.date?.valueOf() ?? 0) - (a.date?.valueOf() ?? 0) || RANK[a.kind] - RANK[b.kind])
  .slice(0, 7);
const viz = [...allViz].sort((a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0)).slice(0, 4);
---

<Base wide>
  <div class="top">
    <section class="intro">
      {SITE.tagline && <p class="eyebrow">{SITE.tagline}</p>}
      <h1>{SITE.title}</h1>
      <p class="bio">{SITE.bio}</p>
      <p class="links">
        <a href="/about/">关于我</a>
        {SITE.github && <a href={SITE.github}>GitHub</a>}
        <a href="/rss.xml">RSS</a>
      </p>
    </section>

    {
      news.length > 0 && (
        <section class="news" aria-label="动态">
          <h2 class="block-label"><span>动态</span></h2>
          <ol class="timeline">
            {news.map((e, i) => {
              const sameDay = i > 0 && fmtDate(news[i - 1].date) === fmtDate(e.date);
              return (
                <li class:list={[{ first: i === 0 }]}>
                  <time class="tl-date" datetime={e.date?.toISOString()}>{sameDay ? '' : fmtDate(e.date)}</time>
                  <div class="tl-body">
                    <span class="tl-kind">{e.kind}{e.where && ` · ${e.where}`}</span>
                    <a class="tl-title" href={e.href}>{e.title}</a>
                    {i === 0 && e.desc && <p class="tl-desc">{e.desc}</p>}
                  </div>
                </li>
              );
            })}
          </ol>
        </section>
      )
    }
  </div>

  {
    viz.length > 0 && (
      <section class="block">
        <h2 class="block-label">
          <span>交互可视化</span>
          <a href="/viz/">全部 →</a>
        </h2>
        <div class="viz-grid">
          {viz.map((v) => <VizCard v={v} />)}
        </div>
      </section>
    )
  }

  {
    series.length > 0 && (
      <section class="block">
        <h2 class="block-label">
          <span>笔记系列</span>
          <a href="/notes/">全部 →</a>
        </h2>
        <div class="card-grid">
          {series.map((s) => (
            <a class="card" href={`/notes/${s.id}/`}>
              <h3>{s.title}</h3>
              {s.description && <p>{s.description}</p>}
              <div class="meta num">
                {s.notes.length} 篇{s.updated && ` · 更新于 ${fmtDate(s.updated)}`}
              </div>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <Globe />
</Base>

<style>
  .top {
    display: grid;
    gap: 3.5rem;
    padding-top: 2.5rem;
  }
  @media (min-width: 56rem) {
    .top {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: 5rem;
      align-items: start;
    }
    .intro {
      position: sticky;
      top: 7rem;
      padding-top: 2.25rem;
    }
  }
  .eyebrow {
    font-size: 0.8125rem;
    color: var(--accent);
    margin: 0 0 1rem;
  }
  .intro h1 {
    font-size: clamp(2.8rem, 6vw, 4rem);
    line-height: 1.05;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 0 0 1.1rem;
  }
  .bio {
    font-size: 1.125rem;
    line-height: 1.8;
    color: var(--fg-soft);
    margin: 0 0 1.75rem;
  }
  .links {
    display: flex;
    gap: 1.5rem;
    margin: 0;
    font-size: 0.9375rem;
  }
  .links a {
    color: var(--muted);
    text-decoration: none;
  }
  .links a:hover {
    color: var(--accent);
  }

  /* 动态时间线 */
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .timeline li {
    display: grid;
    grid-template-columns: 6.2rem minmax(0, 1fr);
  }
  .tl-date {
    font-size: 0.8125rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    padding-top: 0.15rem;
  }
  .tl-body {
    position: relative;
    display: grid;
    gap: 0.2rem;
    padding: 0 0 1.6rem 1.5rem;
    border-left: 1px solid var(--border);
  }
  .timeline li:last-child .tl-body {
    border-left-color: transparent;
    padding-bottom: 0;
  }
  .tl-body::before {
    content: '';
    position: absolute;
    left: -4px;
    top: 0.42rem;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--bg);
    box-shadow: 0 0 0 1px var(--muted);
  }
  .first .tl-body::before {
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }
  .tl-kind {
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .first .tl-kind {
    color: var(--accent);
  }
  .tl-title {
    text-decoration: none;
    color: var(--fg);
    line-height: 1.5;
    font-weight: 500;
  }
  .first .tl-title {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    font-weight: 600;
    line-height: 1.35;
    margin-top: 0.1rem;
  }
  .tl-title:hover {
    color: var(--accent);
  }
  .tl-desc {
    margin: 0.35rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.75;
    color: var(--fg-soft);
  }
  @media (max-width: 34rem) {
    .timeline li {
      grid-template-columns: 5.4rem minmax(0, 1fr);
    }
    .tl-date {
      font-size: 0.75rem;
    }
    .tl-body {
      padding-left: 1.1rem;
    }
  }

  .block {
    margin-top: 4.5rem;
  }
  .block-label {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    color: var(--muted);
    margin: 0 0 1.5rem;
  }
  .block-label::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border);
    order: 1;
  }
  .block-label a {
    order: 2;
    letter-spacing: 0;
    text-decoration: none;
    font-weight: 400;
  }

</style>
