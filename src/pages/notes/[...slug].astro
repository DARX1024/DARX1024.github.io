---
import { render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import Viz from '../../components/Viz.astro';
import { getNotes, getSeries, seriesIdOf, titleOf, readingMinutes, vtName, type Note, type Series } from '../../lib/content';

export async function getStaticPaths() {
  const [notes, series] = await Promise.all([getNotes(), getSeries()]);
  return notes.map((note) => {
    const s = series.find((x) => x.id === seriesIdOf(note));
    const i = s ? s.notes.findIndex((n) => n.id === note.id) : -1;
    return {
      params: { slug: note.id },
      props: { note, series: s, index: i, prev: s?.notes[i - 1], next: s?.notes[i + 1] },
    };
  });
}

interface Props {
  note: Note;
  series?: Series;
  index: number;
  prev?: Note;
  next?: Note;
}
const { note, series, index, prev, next } = Astro.props;
const { Content, headings } = await render(note);
const { lecture, course, textbook } = note.data;
const position = lecture != null ? `第 ${lecture} 讲` : series && series.notes.length > 1 ? `${index + 1} / ${series.notes.length}` : '';
---

<Article
  title={titleOf(note)}
  description={note.data.description}
  date={note.data.date}
  updated={note.data.updated}
  tags={note.data.tags}
  minutes={readingMinutes(note.body)}
  headings={headings}
  showToc={note.data.toc}
  vt={vtName('note', note.id)}
>
  <p slot="kicker" class="kicker">
    <a href="/notes/">笔记</a>
    {series && <> / <a href={`/notes/${series.id}/`}>{series.title}</a></>}
    {position && <span class="num"> · {position}</span>}
  </p>
  <Content components={{ Viz }} />
  {
    (course || textbook) && (
      <dl slot="after" class="source">
        {course && <><dt>课程</dt><dd>{course}{lecture != null && `，第 ${lecture} 讲`}</dd></>}
        {textbook && <><dt>教材</dt><dd>{textbook}</dd></>}
      </dl>
    )
  }
  {
    (prev || next) && (
      <nav slot="after" class="pager">
        {prev ? <a href={`/notes/${prev.id}/`}><span>← 上一篇</span>{titleOf(prev)}</a> : <span />}
        {next && <a class="next" href={`/notes/${next.id}/`}><span>下一篇 →</span>{titleOf(next)}</a>}
      </nav>
    )
  }
</Article>

<style>
  .kicker {
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    color: var(--muted);
    margin: 0 0 0.9rem;
  }
  .kicker a {
    text-decoration: none;
    color: var(--accent);
  }
  .source {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.35rem 1rem;
    margin: 3.5rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .source dt {
    color: var(--fg-soft);
  }
  .source dd {
    margin: 0;
  }
</style>
