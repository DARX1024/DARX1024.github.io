---
import Base from '../../../layouts/Base.astro';
import { getSeries, titleOf, vtStyle, type Series } from '../../../lib/content';

export async function getStaticPaths() {
  return (await getSeries()).map((s) => ({ params: { series: s.id }, props: { s } }));
}
const { s } = Astro.props as { s: Series };
---

<Base title={s.title} description={s.description}>
  <p class="kicker"><a href="/notes/">笔记</a></p>
  <h1 class="page-title" style={vtStyle('series', s.id)}>{s.title}</h1>
  {
    (s.description || s.url) && (
      <p class="page-lede">
        {s.description}
        {s.url && <a class="course" href={s.url}>课程主页 ↗</a>}
      </p>
    )
  }
  <ol class="entry-list compact">
    {
      s.notes.map((n, i) => (
        <li>
          <span class="meta">{String(n.data.lecture ?? i + 1).padStart(2, '0')}</span>
          <a href={`/notes/${n.id}/`} style={vtStyle('note', n.id)}>
            {titleOf(n)}
          </a>
          {n.data.description && <span class="desc">{n.data.description}</span>}
        </li>
      ))
    }
  </ol>
</Base>

<style>
  .kicker {
    font-size: 0.875rem;
    color: var(--muted);
    margin: 0 0 0.5rem;
  }
  .kicker a {
    text-decoration: none;
  }
  .course {
    display: block;
    width: fit-content;
    margin-top: 0.5rem;
    font-size: 0.875rem;
    color: var(--muted);
    text-decoration: none;
  }
  .course:hover {
    color: var(--accent);
  }
</style>
