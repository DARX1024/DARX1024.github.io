---
import '../styles/prose.css';
import 'katex/dist/katex.min.css';
import Base from '../layouts/Base.astro';
import { getEntry, render } from 'astro:content';

// 内容在 src/content/pages/about.md，可以直接在 Obsidian 里改
const page = await getEntry('pages', 'about');
if (!page) throw new Error('缺少 src/content/pages/about.md');
const { Content } = await render(page);
---

<Base title={page.data.title} description={page.data.description}>
  <h1 class="page-title">{page.data.title}</h1>
  <div class="prose" style="margin-top: 2rem">
    <Content />
  </div>
</Base>
