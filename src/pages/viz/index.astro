---
import Base from '../../layouts/Base.astro';
import VizCard from '../../components/VizCard.astro';
import { getCollection } from 'astro:content';

const viz = (await getCollection('viz')).sort((a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0));
---

<Base title="交互可视化" description="交互可视化" wide>
  <h1 class="page-title sr-only">交互可视化</h1>
  <div class="viz-grid">
    {viz.map((v) => <VizCard v={v} meta vt />)}
  </div>
  {viz.length === 0 && <p class="muted">还没有内容。</p>}
</Base>
