---
// 游戏墙上的一张海报。悬停时：海报跟着鼠标轻微 3D 倾斜，表面有一道随鼠标移动的反光，
// 背后透出一圈封面颜色的柔光（像把唱片从架子上抽出来）。点击打开详情卡（见 pages/games/index.astro）。
import { STATUS_LABEL, fmtHours, type Game } from '../lib/games';

interface Props {
  g: Game;
  /** 首屏的几张不懒加载 */
  eager?: boolean;
  /** 不在游戏墙页面时（比如生活页），点击跳到游戏墙并打开这款游戏的详情 */
  external?: boolean;
  /** 显示在海报下方的小字；默认是「状态 · 时长」 */
  meta?: string;
}
const { g, eager = false, external = false, meta } = Astro.props;
const review = !!g.href && !g.external;
const pct = g.ach && g.ach[1] > 0 ? g.ach[0] / g.ach[1] : undefined;
const line =
  meta ?? [g.status && STATUS_LABEL[g.status], fmtHours(g.hours) || (g.platform !== 'Steam' ? g.platform : '')].filter(Boolean).join(' · ');
// 没有 JS 时的去处：有评测去评测页，否则 Steam 商店
const href = external ? `/games/#${encodeURIComponent(g.slug)}` : g.href ?? `#${encodeURIComponent(g.slug)}`;
// 竖版封面加载失败 → 换横版头图 → 再失败就显示文字封面
const onerror =
  "var f=this.dataset.fallback;if(f){this.removeAttribute('data-fallback');this.src=f;this.classList.add('wide')}else{this.closest('.poster').classList.add('no-img')}";
---

<a
  class:list={['game', { review, recent: g.recent }]}
  href={href}
  data-game={g.slug}
  style={g.cover ? `--cover:url("${g.cover}")` : undefined}
>
  <span class="tilt">
    <span class:list={['poster', { 'no-img': !g.cover }]}>
      {
        g.cover && (
          <img
            src={g.cover}
            data-fallback={g.coverFallback}
            alt=""
            loading={eager ? 'eager' : 'lazy'}
            decoding="async"
            referrerpolicy="no-referrer"
            onerror={onerror}
          />
        )
      }
      <span class="poster-text" aria-hidden="true">{g.title}</span>
      {g.rating != null && <span class="rating num" title="评分（10 分制）">{g.rating.toFixed(1)}</span>}
      {
        pct != null && (
          <span class="ach" title={`成就 ${g.ach![0]} / ${g.ach![1]}`}>
            <span style={`transform:scaleX(${pct})`} />
          </span>
        )
      }
      <span class="sheen" aria-hidden="true"></span>
    </span>
  </span>
  <span class="g-title">
    {g.title}
    {
      review && (
        <svg class="pen" viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-label="有评测">
          <path d="M3 13l1-3.5 7-7a1.4 1.4 0 0 1 2 2l-7 7z" />
          <path d="M9.5 4l2.5 2.5" />
        </svg>
      )
    }
  </span>
  {line && <span class="g-meta">{line}</span>}
</a>

<style>
  .game {
    --rx: 0deg;
    --ry: 0deg;
    --mx: 50%;
    --my: 30%;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
    text-decoration: none;
    color: inherit;
    -webkit-tap-highlight-color: transparent;
  }
  /* 封面色的柔光：悬停时从海报背后透出来 */
  .game::before {
    content: '';
    position: absolute;
    z-index: 0;
    left: 6%;
    top: 8%;
    aspect-ratio: 2 / 3;
    width: 88%;
    background: var(--cover) center / cover;
    filter: blur(26px) saturate(1.6);
    opacity: 0;
    transform: translateY(6%) scale(0.9);
    transition: opacity 0.5s ease, transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
    pointer-events: none;
  }
  .tilt {
    position: relative;
    z-index: 1;
    display: block;
    margin-bottom: 0.6rem;
    perspective: 900px;
  }
  .poster {
    position: relative;
    display: block;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    border-radius: 6px;
    background: var(--bg-soft);
    /* 一圈极细的内描边 + 底部投影，像实体封套的厚度 */
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.06),
      0 1px 2px rgb(0 0 0 / 0.2),
      0 8px 18px -10px rgb(0 0 0 / 0.5);
    transform: rotateX(var(--rx)) rotateY(var(--ry));
    transform-style: preserve-3d;
    transition:
      transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1),
      box-shadow 0.5s ease;
  }
  :global(:root[data-theme='light']) .poster {
    box-shadow:
      inset 0 0 0 1px rgb(0 0 0 / 0.06),
      0 1px 2px rgb(0 0 0 / 0.08),
      0 8px 18px -10px rgb(0 0 0 / 0.3);
  }
  .poster img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* 平时略收一点饱和与亮度，和页面的暖色调融在一起；选中时完全展开 */
    filter: saturate(0.82) brightness(0.94);
    transition:
      filter 0.45s ease,
      transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  :global(:root[data-theme='dark']) .poster img {
    filter: saturate(0.8) brightness(0.84);
  }
  .poster img.wide {
    object-fit: contain;
  }
  .poster.no-img img {
    display: none;
  }
  .poster-text {
    position: absolute;
    inset: 0;
    display: none;
    place-items: end start;
    padding: 0.9rem;
    font-family: var(--font-heading);
    font-size: 1.05rem;
    line-height: 1.3;
    color: var(--accent);
    background: radial-gradient(120% 90% at 100% 0%, var(--accent-soft), transparent 65%);
  }
  .poster.no-img .poster-text {
    display: grid;
  }
  /* 反光：一块跟着鼠标走的柔和高光 + 一道斜向的光带 */
  .sheen {
    position: absolute;
    inset: 0;
    opacity: 0;
    background:
      radial-gradient(circle at var(--mx) var(--my), rgb(255 255 255 / 0.28), transparent 42%),
      linear-gradient(115deg, transparent 35%, rgb(255 255 255 / 0.08) 45%, transparent 55%);
    mix-blend-mode: soft-light;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }
  .rating {
    position: absolute;
    z-index: 1;
    top: 0.45rem;
    right: 0.45rem;
    padding: 0.05rem 0.42rem;
    border-radius: 4px;
    font-family: var(--font-heading);
    font-size: 0.8125rem;
    line-height: 1.5;
    color: #f3ece0;
    background: rgb(20 18 16 / 0.62);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }
  .ach {
    position: absolute;
    z-index: 1;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: rgb(0 0 0 / 0.35);
  }
  .ach span {
    display: block;
    height: 100%;
    background: var(--accent);
    transform-origin: 0 50%;
  }

  /* ---- 选中（悬停 / 键盘聚焦） ---- */
  .game:hover::before,
  .game:focus-visible::before {
    opacity: 0.55;
    transform: translateY(10%) scale(1);
  }
  .game:hover .poster,
  .game:focus-visible .poster {
    transform: translateY(-6px) rotateX(var(--rx)) rotateY(var(--ry)) scale(1.03);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.1),
      0 2px 4px rgb(0 0 0 / 0.2),
      0 22px 36px -16px rgb(0 0 0 / 0.65);
  }
  .game:hover .poster img,
  .game:focus-visible .poster img {
    filter: none;
    transform: scale(1.04);
  }
  .game:hover .sheen,
  .game:focus-visible .sheen {
    opacity: 1;
  }
  .game:focus-visible {
    outline: none;
  }
  .game:focus-visible .poster {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  /* 跟随鼠标时不要过渡延迟，否则倾斜会「拖」在鼠标后面 */
  .game.tracking .poster {
    transition:
      transform 0.12s linear,
      box-shadow 0.5s ease;
  }
  @media (prefers-reduced-motion: reduce) {
    .game .poster,
    .game:hover .poster {
      transform: none;
    }
    .game::before {
      display: none;
    }
  }
  /* 触屏没有悬停：封面直接用原色 */
  @media (hover: none) {
    .poster img,
    :global(:root[data-theme='dark']) .poster img {
      filter: none;
    }
  }

  .g-title {
    position: relative;
    z-index: 1;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.9375rem;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.2s;
  }
  .game:hover .g-title {
    color: var(--accent);
  }
  .pen {
    display: inline-block;
    vertical-align: -0.05em;
    margin-left: 0.3em;
    color: var(--accent);
  }
  .g-meta {
    position: relative;
    z-index: 1;
    font-size: 0.75rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .recent .g-meta::before {
    content: '';
    display: inline-block;
    width: 5px;
    height: 5px;
    margin-right: 0.4em;
    vertical-align: 0.15em;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }
</style>

<script>
  // 鼠标在海报上移动时：算出倾斜角度和高光位置，写进 CSS 变量。全站只绑一次（事件委托）
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches && matchMedia('(hover: hover)').matches) {
    let frame = 0;
    document.addEventListener('pointermove', (e) => {
      const card = (e.target as Element).closest?.<HTMLElement>('a.game');
      if (!card) return;
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        const r = card.querySelector('.poster')!.getBoundingClientRect();
        const x = Math.min(1, Math.max(0, (e.clientX - r.left) / r.width));
        const y = Math.min(1, Math.max(0, (e.clientY - r.top) / r.height));
        card.classList.add('tracking');
        card.style.setProperty('--ry', `${(x - 0.5) * 14}deg`);
        card.style.setProperty('--rx', `${(0.5 - y) * 12}deg`);
        card.style.setProperty('--mx', `${x * 100}%`);
        card.style.setProperty('--my', `${y * 100}%`);
      });
    });
    document.addEventListener(
      'pointerout',
      (e) => {
        const card = (e.target as Element).closest?.<HTMLElement>('a.game');
        if (!card || card.contains(e.relatedTarget as Node)) return;
        card.classList.remove('tracking');
        for (const k of ['--rx', '--ry', '--mx', '--my']) card.style.removeProperty(k);
      },
      true,
    );
  }
</script>
